/* Animação suave para quando os inputs estiverem desativados (após salvar o palpite) */
input:disabled {
    background-color: #f3f4f6 !important;
    color: #9ca3af !important;
    cursor: not-allowed;
    border-color: #e5e7eb !important;
}

/* Efeito de foco mais bonito nos campos de placar */
input[type="number"]:focus {
    transform: scale(1.05);
    transition: transform 0.2s ease;
}

/* Garante que os cards brancos tenham uma leve transparência moderna */
#auth-section, #app-section {
    background-color: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
}

/* Sombra extra no título para destacar bem em cima do estádio */
h1 {
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.6);
}
